# Frappe (club_management) — solo server-side
# Local: preferí 127.0.0.1 (dev.localhost puede resolver a ::1 y fallar en Docker).
FRAPPE_BASE_URL=http://127.0.0.1:8000
FRAPPE_SITE_HOST=dev.localhost
# Preview/prod Vercel: URL pública del site Frappe (p. ej. https://gestion.icdpedroechague.com.ar)
# FRAPPE_BASE_URL=https://gestion.icdpedroechague.com.ar
# FRAPPE_SITE_HOST=gestion.icdpedroechague.com.ar
# Opcional: secreto compartido cuando el backend exija X-Portal-Key
# FRAPPE_PORTAL_KEY=

# Existentes del sitio
# SANITY_API_TOKEN=
# ADMIN_PASSWORD=
# ADMIN_SECRET=
